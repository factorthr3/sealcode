# Sealed environment variables for `phala deploy -e`. Encrypted on your machine to the CVM's key
# and readable only inside the TEE. Never commit a filled-in copy.
#
# Generate secrets with:  openssl rand -base64 48   (TOTP_ENCRYPTION_KEY: openssl rand -base64 32)

PHALA_API_KEY=
POSTGRES_PASSWORD=
# Changing KEY_PEPPER invalidates every API key.
KEY_PEPPER=
PLAYGROUND_TOKEN_SECRET=
# Exactly 32 bytes, base64.
TOTP_ENCRYPTION_KEY=
RESEND_API_KEY=
# DNS-01 challenges for the TEE-held TLS certificates (Zone:DNS:Edit on sealcode.dev only).
CLOUDFLARE_API_TOKEN=
CERTBOT_EMAIL=
# Backups: keep an offline escrow copy of this key (see deploy/runbooks/backup-restore.md).
BACKUP_ENCRYPTION_KEY=
# Optional off-site copies to S3-compatible storage. Leave empty to keep backups on the CVM volume.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
