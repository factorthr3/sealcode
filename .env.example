# Copy to .env for local development. Never commit real values.
# In production every secret is a Phala sealed environment variable (see deploy/README.md).

# --- Postgres -----------------------------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/sealcode
TEST_DATABASE_URL=postgres://localhost:5432/sealcode_test

# --- Gateway ------------------------------------------------------------------------------------
GATEWAY_PORT=8787
# Phala's attested inference gateway. Leave PHALA_API_KEY empty to use the local mock upstream.
UPSTREAM_BASE_URL=http://127.0.0.1:8788
PHALA_API_KEY=
# At least 32 random characters. Changing it invalidates every API key.
KEY_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# Shared by web (signs) and gateway (verifies). At least 32 characters.
PLAYGROUND_TOKEN_SECRET=dev-only-playground-secret-0123456789abcdef
# Origin allowed to call the gateway from the browser playground.
PLAYGROUND_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Web ----------------------------------------------------------------------------------------
WEB_PORT=3000
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_GATEWAY_URL=http://localhost:8787
# 32 bytes, base64. Encrypts TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktMzItYnl0ZXMtbG9uZyE=
# Resend API key for transactional email. Empty = print emails to the web server's stdout (dev only).
RESEND_API_KEY=
EMAIL_FROM="Sealcode <info@sealcode.ai>"
SALES_INBOX=info@sealcode.ai
# Public git reference shown on /trust.
SOURCE_REPO_URL=https://github.com/factorthr3/sealcode
SOURCE_COMMIT=dev
