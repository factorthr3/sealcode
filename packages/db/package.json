{
  "name": "@sealcode/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./gateway-store": "./src/gateway-store.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate-cli.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "staff:grant": "tsx src/staff-grant.ts",
    "build:migrate": "esbuild src/migrate-cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/migrate.js --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@sealcode/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2"
  }
}
